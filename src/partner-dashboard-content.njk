---
layout: layouts/partner.njk
permalink: /partner-dashboard/content/index.html
title: "Submit content — Partner Portal — WhereTo"
description: "Send content to WhereTo for approval."
eleventyExcludeFromCollections: true
navActive: content
---
<main id="wt-dash-page">

  {# Loading / gate #}
  <div id="wt-dash-gate" class="gate-msg">Loading…</div>

  {# Not a partner #}
  <div id="wt-dash-notaff" class="acct" style="display:none;">
    <div class="acct-card" style="text-align:center;">
      <p class="eyebrow">Partner program</p>
      <h1>You're not a partner yet</h1>
      <p class="acct-sub">This page is for WhereTo partners. Partner accounts are invitation-only.</p>
      <p><a class="btn btn-primary" href="/account/profile/">Back to my account</a></p>
      <p class="acct-links"><a href="/partners/">Learn about the creator program</a></p>
    </div>
  </div>

  <div id="wt-dash-root" class="pp wrap" style="display:none;">

    <div class="pp-head">
      <div>
        <p class="pp-eyebrow">Submit content</p>
        <h1>Send something for approval</h1>
      </div>
    </div>

    <div class="pp-two">
      <section class="pp-card pp-panel" aria-labelledby="form-h">
        <div id="done" class="pp-done" hidden>
          <h2 id="done-h" tabindex="-1">Received. We'll review it within three business days.</h2>
          <p class="pp-hint" style="margin-bottom:20px;">Once it's approved, your tracking link and promo code appear on the Content performance tab.</p>
          <button type="button" class="pp-ghost" id="again">Submit another</button>
        </div>

        <form id="form" class="pp-form" novalidate>
          <h2 id="form-h" style="margin:0;">Content details</h2>
          <div>
            <div class="pp-lbl" id="mode-l">What are you sending?</div>
            <div role="group" aria-labelledby="mode-l" class="pp-seg" id="mode"></div>
          </div>

          <div>
            <label class="pp-lbl" for="f-title">Title</label>
            <input id="f-title" class="pp-inp" type="text" placeholder="Short name you'll recognize later" aria-describedby="e-title">
            <p class="pp-err" id="e-title" role="alert"></p>
          </div>
          <div class="pp-fields2">
            <div>
              <label class="pp-lbl" for="f-kind">Content type</label>
              <select id="f-kind" class="pp-inp">
                <option>Video</option><option>Photo or carousel</option><option>Short post or story</option>
                <option>Newsletter</option><option>Podcast episode</option><option>Article or blog post</option><option>Other</option>
              </select>
            </div>
            <div>
              <label class="pp-lbl" for="f-platform">Platform</label>
              <select id="f-platform" class="pp-inp">
                <option>Instagram</option><option>YouTube</option><option>TikTok</option><option>Facebook</option>
                <option>Newsletter</option><option>Podcast</option><option>Blog or website</option><option>Other</option>
              </select>
            </div>
          </div>

          <div id="g-file">
            <div class="pp-lbl" id="l-file">Your file</div>
            <div class="pp-drop" id="drop" role="button" tabindex="0" aria-labelledby="l-file" aria-describedby="h-file e-file">
              <strong>Drag a file here</strong>
              <span>or <u>choose a file</u> from your device</span>
            </div>
            <input id="f-file" type="file" hidden accept="image/jpeg,image/png,image/webp,image/gif,image/heic,application/pdf,video/mp4,video/quicktime,audio/mpeg,audio/wav">
            <div class="pp-file" id="file-info" hidden>
              <span class="pp-file-name" id="file-name"></span>
              <span class="pp-file-size pp-num" id="file-size"></span>
              <span class="pp-file-state" id="file-state" role="status" aria-live="polite"></span>
              <button type="button" class="pp-linkbtn" id="file-remove">Remove</button>
            </div>
            <p class="pp-hint" id="h-file">One file. Images, PDF, MP4 or MOV video, and MP3 or WAV audio, up to 100 MB.</p>
            <p class="pp-err" id="e-file" role="alert"></p>
          </div>
          <div id="g-event" class="pp-fields2" hidden>
            <div>
              <label class="pp-lbl" for="f-date">Event date</label>
              <input id="f-date" class="pp-inp" type="date" aria-describedby="e-date">
              <p class="pp-err" id="e-date" role="alert"></p>
            </div>
            <div>
              <label class="pp-lbl" for="f-venue">Venue or channel</label>
              <input id="f-venue" class="pp-inp" type="text" placeholder="Where it's happening" aria-describedby="e-venue">
              <p class="pp-err" id="e-venue" role="alert"></p>
            </div>
          </div>

          <div>
            <label class="pp-lbl" for="f-notes">Notes for the reviewer</label>
            <textarea id="f-notes" class="pp-inp" placeholder="Anything we should know before we look at it"></textarea>
          </div>

          <p class="pp-hint">Remember to include your sponsorship disclosure in the content itself.</p>
          <p class="pp-err" id="e-form" role="alert"></p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;">
            <button type="submit" class="pp-primary" id="send">Submit for approval</button>
            <button type="button" class="pp-ghost" id="draft">Save draft</button>
          </div>
          <p class="pp-hint" id="saved" role="status" aria-live="polite"></p>
        </form>
      </section>

      <aside class="pp-card pp-panel pp-next" aria-labelledby="next-h">
        <h2 id="next-h" style="margin-bottom:14px;font-size:22px;">What happens next</h2>
        <ol>
          <li>We check the piece against our brand guidelines, usually within three business days.</li>
          <li>If it's approved, we issue a tracking link and promo code for that piece.</li>
          <li>The piece appears on your Content performance tab and starts collecting numbers.</li>
          <li>If we ask for changes, the note comes to your email and you can resubmit.</li>
        </ol>
      </aside>
    </div>
  </div>
</main>
<script type="module" src="/assets/js/wt-partner-content.js?v={{ buildTime }}"></script>
