{# Sticky reply bar — phones only, and never over the form it duplicates. #}
<div class="tp-bar" id="tp-bar">
  <a class="btn btn-primary" href="{{ booking }}">Book a short call</a>
</div>
<script>
  // Zoho's calendar takes several seconds to start up, so it begins loading as
  // soon as the page itself has finished rather than when it scrolls into
  // view (loading="lazy"), where a "Book a short call" tap would land on a
  // blank frame. After the load event, so it never slows the hero.
  (function () {
    var f = document.getElementById('tp-cal-frame');
    if (!f) return;
    function go() { if (!f.src) f.src = f.getAttribute('data-src'); }
    if (document.readyState === 'complete') go(); else window.addEventListener('load', go);
  })();
  (function () {
    var bar = document.getElementById('tp-bar');
    var hero = document.querySelector('.hero-slider');
    var cta = document.querySelector('[data-tp-cta]');
    if (!bar || !hero || !cta) return;
    // A scroll listener rather than an IntersectionObserver: same behavior,
    // and its state can actually be asserted from a headless run, where IO
    // delivery is suppressed.
    var heroBottom = 0;
    function measure() {
      heroBottom = hero.getBoundingClientRect().bottom + window.scrollY;
      sync();
    }
    function sync() {
      var past = window.scrollY > heroBottom - 40;
      // Once the application comes into view the bar stays down for the
      // rest of the page, rather than popping back up over the footer.
      var reachedCta = cta.getBoundingClientRect().top < window.innerHeight;
      bar.classList.toggle('is-on', past && !reachedCta);
    }
    measure();
    window.addEventListener('load', measure);
    window.addEventListener('resize', measure);
    window.addEventListener('scroll', sync, { passive: true });
  })();
</script>
