{#- ══════════════════════════════════════════════════════════════════
    One airport, opened up.

    /destinations/ argues that a destination is not an airport code. The
    fastest way to show that is to take one gateway and list what it
    actually reaches, each thing scored on its own merits. The data is
    real rows from vibe_destination_rankings, picked by
    scripts/gen-engine-stats.js, not an illustration.

    Reuses the .vibe-score list from the featured-vibe detail pages,
    since it is the same idea: a place, a reason, a number.
    ══════════════════════════════════════════════════════════════════ -#}
{%- set gw = engineStats.gateway -%}
<section class="block{% if s.background %} tint{% endif %}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="wrap">
    <div class="sec-head center reveal">
      {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
      {% if s.title %}<h2>{{ s.title.pre }}<span class="italic">{{ s.title.accent }}</span>{{ s.title.post }}</h2>{% endif %}
      {% if s.lede %}<p class="lede">{{ s.lede }}</p>{% endif %}
    </div>

    <p class="gw-line reveal reveal-delay-1">
      <span class="gw-code">{{ gw.iata }}</span>
      <span class="gw-arrow" aria-hidden="true">&rarr;</span>
      <span class="gw-count"><strong>{{ gw.placeCount }}</strong> places</span>
      <span class="gw-sep" aria-hidden="true">·</span>
      <span class="gw-count"><strong>{{ gw.vibeCount }}</strong> vibes</span>
      <span class="gw-sep" aria-hidden="true">·</span>
      <span class="gw-count"><strong>{{ gw.totalRows }}</strong> scored rows</span>
    </p>

    <ul class="vibe-scores reveal reveal-delay-1">
      {% for p in gw.places %}
      <li class="vibe-score{% if loop.first %} is-hero{% endif %}">
        <span class="vibe-score-label">
          {{ p.place }}
          <em><strong>{{ p.vibe }}</strong>{% if p.note %} · {{ p.note }}{% endif %}</em>
        </span>
        <span class="vibe-score-bar" aria-hidden="true"><span style="width: {{ p.score }}%;"></span></span>
        <span class="vibe-score-num">{{ p.score }}</span>
      </li>
      {% endfor %}
    </ul>

    {% if s.footnote %}<p class="app-disclaimer reveal">{{ s.footnote }}</p>{% endif %}
  </div>
</section>
