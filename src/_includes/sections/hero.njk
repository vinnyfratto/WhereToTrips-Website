{#- Hero section.
    Two modes:
     • Slider hero  → when `s.slides` (a list of {src, alt}) is provided.
       Full-viewport rotating background images with an overlaid caption.
       Used on the home page (Varaus "Home Style 1" treatment).
     • Split hero   → the original two-column copy + image-card layout.
       Used by the inner hub pages. Unchanged.
-#}
{% if s.slides %}
<section class="hero-slider" data-hero-slider>
  <div class="hero-slides">
    {%- for slide in s.slides %}
    <div class="hero-slide{% if loop.first %} active{% endif %}" role="img"
         aria-label="{{ slide.alt }}"
         style="background-image:url('{{ slide.src }}')"></div>
    {%- endfor %}
    <div class="hero-slide-overlay"></div>
    {% if s.slides.length > 1 %}
    <button class="hero-arrow hero-prev" type="button" aria-label="Previous slide" data-hero-prev>&#8249;</button>
    <button class="hero-arrow hero-next" type="button" aria-label="Next slide" data-hero-next>&#8250;</button>
    <div class="hero-dots" role="tablist" aria-label="Choose slide">
      {%- for slide in s.slides %}
      <button class="hero-dot{% if loop.first %} active{% endif %}" type="button"
              role="tab" aria-label="Slide {{ loop.index }}" data-hero-dot="{{ loop.index0 }}"></button>
      {%- endfor %}
    </div>
    {% endif %}
  </div>

  {#- Single caption, animates in ONCE on load; the images cycle behind it (below it on mobile). -#}
  <div class="wrap hero-caption-wrap">
    <div class="slide-caption">
      {% if s.eyebrow %}<div class="slide-eyebrow"><span class="eyebrow">{{ s.eyebrow }}</span></div>{% endif %}
      <div class="slide-title"><h1>{{ s.title.pre }} <span class="italic">{{ s.title.accent }}</span>{{ s.title.post }}</h1></div>
      {% if s.lede %}<div class="slide-subtitle"><p class="lede">{{ s.lede }}</p></div>{% endif %}
      {% if s.primaryBtn or s.ghostBtn %}
      <div class="btns">
        {% if s.primaryBtn %}<a class="btn btn-primary" href="{{ s.primaryBtn.href }}">{{ s.primaryBtn.label }}</a>{% endif %}
        {% if s.ghostBtn %}<a class="btn btn-hero-ghost" href="{{ s.ghostBtn.href }}">{{ s.ghostBtn.label }}</a>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% else %}
<section class="hero">
  <div class="wrap hero-grid">
    <div class="reveal hero-copy">
      {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
      <h1>{{ s.title.pre }} <span class="italic">{{ s.title.accent }}</span>{{ s.title.post }}</h1>
      {% if s.lede %}<p class="lede">{{ s.lede }}</p>{% endif %}
      {% if s.primaryBtn or s.ghostBtn %}
      <div class="cta">
        {% if s.primaryBtn %}<a class="btn btn-primary" href="{{ s.primaryBtn.href }}">{{ s.primaryBtn.label }}</a>{% endif %}
        {% if s.ghostBtn %}<a class="btn btn-ghost" href="{{ s.ghostBtn.href }}">{{ s.ghostBtn.label }}</a>{% endif %}
      </div>
      {% endif %}
    </div>
    <div class="hero-media reveal reveal-delay-1">
      <img class="hero-img" src="{{ s.image.src }}" alt="{{ s.image.alt }}" loading="eager" />
      {% if s.badge %}
      <div class="hero-badge">
        <span class="pulse"></span>
        <div>
          <div class="bt">{{ s.badge.title }}</div>
          <div class="bs">{{ s.badge.subtitle }}</div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
