<section class="block{% if s.background %} tint{% endif %}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="wrap">
    {% if s.eyebrow or s.title %}
    <div class="sec-head center reveal">
      {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
      {#- `asH1` when the FAQ IS the page (/faq/ has no hero), so the page still has one H1. -#}
      {%- set ht = "h1" if s.asH1 else "h2" %}
      {% if s.title %}<{{ ht }}>{{ s.title.pre }} <span class="italic">{{ s.title.accent }}</span>{{ s.title.post }}</{{ ht }}>{% endif %}
    </div>
    {% endif %}
    <div class="faq-list reveal reveal-delay-1">
      {% for item in s.items %}
      <details class="faq-item">
        <summary>{{ item.q }}</summary>
        <div class="faq-body">{{ item.a | safe }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
