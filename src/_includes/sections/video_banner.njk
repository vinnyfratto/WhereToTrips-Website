{#- Video banner — full-width image with a charcoal wash, headline, and a
    play button. No real video required; the button links where you point it. -#}
<section class="video-banner" style="background-image:url('{{ s.image.src }}')"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="video-banner-overlay"></div>
  <div class="wrap video-banner-inner reveal">
    <a class="video-play" href="{{ s.href or '/app/' }}" aria-label="{{ s.playLabel or 'Watch how it works' }}">
      {% icon "play" %}
    </a>
    {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
    {% if s.title %}<h2>{{ s.title.pre }} <span class="italic">{{ s.title.accent }}</span>{{ s.title.post }}</h2>{% endif %}
    {% if s.body %}<p>{{ s.body }}</p>{% endif %}
  </div>
</section>
