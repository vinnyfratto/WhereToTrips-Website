<section class="block{% if s.background %} tint{% endif %}" id="{{ s.id or 'beta-signup' }}">
  <div class="wrap">
    <div class="sec-head center reveal">
      {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
      {% if s.title %}<h2>{{ s.title.pre }} <span class="italic">{{ s.title.accent }}</span>{{ s.title.post }}</h2>{% endif %}
      {% if s.body %}<p class="lede">{{ s.body }}</p>{% endif %}
    </div>

    <form class="contact-form reveal reveal-delay-1" id="beta-signup-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="{{ site.forms.accessKey }}" />
      <input type="hidden" name="subject" value="Beta tester signup — WhereTo" />
      <input type="hidden" name="intent" value="beta_signup" />
      <input type="hidden" name="message" id="beta-message" value="" />
      <input type="text" name="hp_field" style="position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <input type="text" name="name" placeholder="Your name" aria-label="Your name" required />
      <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required />

      <select name="device" aria-label="Device" required>
        <option value="" disabled selected>Which device will you test on?</option>
        <option value="Apple (iPhone/iPad)">Apple (iPhone/iPad)</option>
        <option value="Android">Android</option>
      </select>

      <select name="source" aria-label="Where did you hear about WhereTo" required>
        <option value="" disabled selected>Where did you hear about WhereTo?</option>
        <option value="Social media">Social media</option>
        <option value="Friend or family">Friend or family</option>
        <option value="App Store / Google Play">App Store / Google Play</option>
        <option value="Search engine">Search engine</option>
        <option value="Press or blog">Press or blog</option>
        <option value="Other">Other</option>
      </select>

      <fieldset class="form-radio-group">
        <legend>Have you ever beta tested an app before?</legend>
        <label class="form-radio"><input type="radio" name="beta_tested" value="Yes" required /> Yes</label>
        <label class="form-radio"><input type="radio" name="beta_tested" value="No" required /> No</label>
      </fieldset>

      <input type="text" name="previous_app" id="beta-previous-app" placeholder="What was it?" aria-label="What app did you beta test before" style="display:none;" />

      <label class="form-check">
        <input type="checkbox" name="agree_no_booking" value="Yes" required />
        <span>I understand this is a beta. Real trips will <strong>not</strong> be booked and no money will be collected in the app during the beta.</span>
      </label>

      <button type="submit" class="btn btn-primary">{{ s.buttonLabel or 'Sign up to beta test' }}</button>

      <p class="form-disclaimer">
        By signing up you agree to take part in an unpaid, pre-release beta test of the WhereTo app. The beta is provided "as is," may contain bugs, and may change, be delayed, or be discontinued at any time without notice. Any trip, price, or booking shown during the beta is for testing only, is not a real booking, and is not guaranteed to be honored — WhereTo is not responsible for beta data being lost, reset, or unsaved, and no purchases or payments are processed in the app during the beta. Taking part does not entitle you to compensation, equity, or any ownership or rights in WhereTo, its app, or its business, and does not create any employment or contractor relationship. Feedback you share may be used by WhereTo to improve the product. You can opt out at any time by emailing {{ site.contactEmail }}.
      </p>
    </form>
  </div>
</section>

<script>
(function () {
  var form = document.getElementById('beta-signup-form');
  if (!form) return;
  var radios = form.querySelectorAll('input[name="beta_tested"]');
  var prevApp = document.getElementById('beta-previous-app');
  radios.forEach(function (r) {
    r.addEventListener('change', function () {
      var checked = form.querySelector('input[name="beta_tested"]:checked');
      var showIt = checked && checked.value === 'Yes';
      prevApp.style.display = showIt ? 'block' : 'none';
      if (!showIt) prevApp.value = '';
    });
  });
  form.addEventListener('submit', function () {
    var fd = new FormData(form);
    var tested = fd.get('beta_tested') || '';
    var parts = [
      'Device: ' + (fd.get('device') || ''),
      'Heard about via: ' + (fd.get('source') || ''),
      'Beta tested before: ' + tested + (tested === 'Yes' ? ' — ' + (fd.get('previous_app') || '') : '')
    ];
    document.getElementById('beta-message').value = parts.join('\n');
  });
})();
</script>
