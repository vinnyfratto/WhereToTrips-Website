{#- ══════════════════════════════════════════════════════════════════
    The 24 vibe shelves, with the photos the app uses for them.

    Same photos as the in-app picker (vibe_shelves.image_1..3), pulled
    by scripts/gen-engine-stats.js. Each tile cycles its own three
    through wt-vibe-cards.js, staggered so 24 of them never flip at
    once, and every frame is lazy so the page does not fetch 72 photos
    before it paints.
    ══════════════════════════════════════════════════════════════════ -#}
<section class="block{% if s.background %} tint{% endif %}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="wrap">
    <div class="sec-head center reveal">
      {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
      {% if s.title %}<h2>{{ s.title.pre }} <span class="italic">{{ s.title.accent }}</span>{{ s.title.post }}</h2>{% endif %}
      {% if s.lede %}<p class="lede">{{ s.lede }}</p>{% endif %}
    </div>

    <div class="shelf-grid reveal reveal-delay-1">
      {% for sh in engineStats.shelves %}
      {% if not s.limit or loop.index <= s.limit %}
      <figure class="shelf-tile" data-cycle style="--cycle-delay: {{ loop.index0 * 0.45 }}s;">
        <span class="shelf-tile-img">
          {% for src in sh.images %}
          <img class="dest-photo-frame{% if loop.first %} is-on{% endif %}"
               src="{{ src }}"
               alt="{% if loop.first %}{{ sh.name }}{% endif %}"
               {% if not loop.first %}aria-hidden="true"{% endif %}
               loading="lazy" decoding="async" />
          {% endfor %}
        </span>
        <figcaption>{{ sh.name }}</figcaption>
      </figure>
      {% endif %}
      {% endfor %}
    </div>

    {% if s.footnote %}<p class="app-disclaimer reveal">{{ s.footnote }}</p>{% endif %}
  </div>
</section>
<script src="/assets/js/wt-vibe-cards.js?v={{ buildTime }}" defer></script>
