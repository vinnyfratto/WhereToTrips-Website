{%- set navCta = site.cta.post if site.launchMode == "post" else site.cta.pre -%}
<header>
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="{{ site.brandName }} home">
      <img class="brand-logo" src="/assets/whereto-logo-azure.svg?v={{ buildTime }}" alt="{{ site.brandName }}" width="171" height="34" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {%- for link in site.nav %}
      {%- if link.children %}
      <div class="nav-dropdown">
        <button type="button" aria-haspopup="true">{{ link.label }} <span class="caret">▾</span></button>
        <div class="nav-dropdown-menu">
          {%- for child in link.children %}
          <a href="{{ child.href }}">{{ child.label }}</a>
          {%- endfor %}
        </div>
      </div>
      {%- else %}
      <a href="{{ link.href }}">{{ link.label }}</a>
      {%- endif %}
      {%- endfor %}
      <div class="nav-dropdown nav-dropdown-end">
        <button type="button" aria-haspopup="true">Partner With Us <span class="caret">▾</span></button>
        <div class="nav-dropdown-menu">
          {%- for link in site.partnerNav %}
          <a href="{{ link.href }}">{{ link.label }}</a>
          {%- endfor %}
        </div>
      </div>
    </nav>
    <div class="nav-cta">
      <a class="btn btn-ghost" href="/account/login/" data-wt-account>Log In</a>
      <a class="btn btn-primary" href="/app/">{{ navCta.label }}</a>
    </div>
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    {%- for link in site.nav %}
    {%- if link.children %}
    <span class="mobile-menu-label">{{ link.label }}</span>
    {%- for child in link.children %}
    <a class="mobile-sub" href="{{ child.href }}">{{ child.label }}</a>
    {%- endfor %}
    {%- else %}
    <a href="{{ link.href }}">{{ link.label }}</a>
    {%- endif %}
    {%- endfor %}
    <span class="mobile-menu-label">Partner With Us</span>
    {%- for link in site.partnerNav %}
    <a class="mobile-sub" href="{{ link.href }}">{{ link.label }}</a>
    {%- endfor %}
    <a class="btn btn-ghost mobile-cta" href="/account/login/" data-wt-account>Log In</a>
    <a class="btn btn-primary mobile-cta" href="/app/">{{ navCta.label }}</a>
  </div>
</header>
