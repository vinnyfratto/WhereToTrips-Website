<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a class="brand" href="/" aria-label="{{ site.brandName }} home">
          <img class="brand-logo" src="/assets/whereto-logo-white.svg" alt="{{ site.brandName }}" width="156" height="31" />
        </a>
        <p class="foot-tagline">Tell us your budget and your vibe. We find the destination.</p>
        {% if site.social %}
        <div class="foot-social">
          {%- for s in site.social %}
          <a href="{{ s.href }}" aria-label="{{ s.label }}" target="_blank" rel="noopener">
            {% include "partials/icon-" + s.icon + ".njk" %}
          </a>
          {%- endfor %}
        </div>
        {% endif %}
      </div>

      <div class="foot-links">
        {%- for col in site.footerCols %}
        <div class="foot-col">
          <h4>{{ col.heading }}</h4>
          {%- for link in col.links %}
          <a href="{{ link.href }}"{% if "/account/" in link.href %} data-wt-account{% endif %}>{{ link.label }}</a>
          {%- endfor %}
        </div>
        {%- endfor %}
      </div>

      <div class="foot-news">
        <h4>Newsletter</h4>
        <p>Travel ideas and early-access news. No spam.</p>
        <form class="foot-news-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="{{ site.forms.accessKey }}" />
          <input type="hidden" name="subject" value="Newsletter signup — WhereTo" />
          <input type="hidden" name="intent" value="newsletter" />
          <input type="text" name="hp_field" style="position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required />
          <button type="submit" class="btn btn-primary" aria-label="Subscribe">Subscribe</button>
        </form>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© <span id="year"></span> {{ site.brandName }}. All rights reserved. WhereTo is a mobile app for iOS &amp; Android; this website is informational only.</span>
      <span>Photography via <a href="https://www.pexels.com" target="_blank" rel="noopener">Pexels</a></span>
    </div>
  </div>
</footer>
