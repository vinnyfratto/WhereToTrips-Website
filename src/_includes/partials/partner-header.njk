{#- Partner portal header, intentionally separate from partials/header.njk
    (the marketing site nav). Same logo, own nav.

    Six tabs, in this fixed order, each a real URL: Summary, Content performance,
    Travelers, Bookings, Revenue, Submit content. The page's front matter
    `navActive` marks the current one with aria-current="page". My Submissions is
    a child of Submit content (it has no tab of its own), so it lights that tab.

    Assets (the Asset Library) and Profile are pages, not tabs: plain links at the
    right. There is no Log out button here; sign-out is on Profile. -#}
{%- set tabs = [
  { key: 'summary', label: 'Summary', href: '/partner-dashboard/' },
  { key: 'content-performance', label: 'Content performance', href: '/partner-dashboard/content-performance/' },
  { key: 'travelers', label: 'Travelers', href: '/partner-dashboard/travelers/' },
  { key: 'bookings', label: 'Bookings', href: '/partner-dashboard/bookings/' },
  { key: 'revenue', label: 'Revenue', href: '/partner-dashboard/revenue/' },
  { key: 'content', label: 'Submit content', href: '/partner-dashboard/content/' }
] -%}
{%- set currentTab = 'content' if navActive == 'submissions' else navActive -%}
<header class="pnr-header">
  <div class="wrap pnr-nav">
    <div class="pnr-brand">
      <a class="brand" href="/" aria-label="{{ site.brandName }} home">
        <img class="brand-logo" src="/assets/whereto-logo-azure.svg?v={{ buildTime }}" alt="{{ site.brandName }}" width="171" height="34" />
      </a>
      <span class="pnr-tag">Partner Portal</span>
    </div>
    <nav class="pnr-links" aria-label="Partner portal">
      {%- for t in tabs %}
      <a href="{{ t.href }}"{% if currentTab == t.key %} aria-current="page"{% endif %}>{{ t.label }}</a>
      {%- endfor %}
    </nav>
    <nav class="pnr-util" aria-label="Assets and profile">
      <a href="/partner-dashboard/assets/"{% if navActive == 'assets' %} aria-current="page"{% endif %}>Assets</a>
      <a href="/partner-dashboard/settings/"{% if navActive == 'settings' %} aria-current="page"{% endif %}>Profile</a>
    </nav>
  </div>
</header>
