{#- The official badges, kept as published in /StoreBadges/ (Apple SVG, Google Play PNG).
    Don't recolor, crop or restyle them: both stores' brand rules forbid it. -#}
<div class="store-btns">
  <a href="{{ site.store.appleHref }}" class="store-badge store-badge-apple" aria-label="Download on the App Store">
    <img src="/StoreBadges/app-store-badge-black.svg" alt="Download on the App Store" height="54" />
  </a>
  <a href="{{ site.store.googleHref }}" class="store-badge store-badge-google" aria-label="Get it on Google Play">
    <img src="/StoreBadges/google-play-badge.png" alt="Get it on Google Play" height="80" />
  </a>
</div>
