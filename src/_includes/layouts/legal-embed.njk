<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    /* Chrome-free rendering of the same legal markdown the public pages use,
       for display inside the app's WebView. Palette mirrors src/Skins —
       cream #F2F5F7, charcoal #313131, azure #209CE0. No nav, no footer:
       the app supplies the header and the back control. */
    :root {
      --bg: #F2F5F7;
      --text: #313131;
      --text-2: #5C616A;
      --text-3: #8A9098;
      --accent: #209CE0;
      --border: #D2D8DD;
      --panel: #FFFFFF;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      padding: 20px 18px 56px;
      background: var(--bg);
      color: var(--text-2);
      font-family: 'Noto Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 15px;
      font-weight: 300;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      overflow-wrap: break-word;
    }
    h2, h3 { color: var(--text); font-weight: 600; line-height: 1.3; }
    h2 { font-size: 19px; margin: 34px 0 10px; }
    h3 { font-size: 16px; margin: 24px 0 8px; }
    h2:first-child, h3:first-child { margin-top: 0; }
    p { margin: 0 0 14px; }
    strong { color: var(--text); font-weight: 600; }
    a { color: var(--accent); text-decoration: none; }
    ul, ol { margin: 0 0 14px; padding-left: 20px; }
    li { margin-bottom: 8px; }
    hr { border: 0; border-top: 1px solid var(--border); margin: 28px 0; }

    /* The two data tables are wide by nature. They scroll inside their own
       box so the document itself never scrolls sideways on a phone. */
    .table-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 16px 0 22px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--panel);
    }
    .table-scroll table { border-collapse: collapse; width: 100%; font-size: 13px; line-height: 1.55; }
    .table-scroll th, .table-scroll td {
      padding: 10px 12px; text-align: left; vertical-align: top;
      min-width: 150px; border-bottom: 1px solid var(--border); border-right: 1px solid var(--border);
    }
    .table-scroll th { background: #EEF2F5; color: var(--text); font-weight: 600; white-space: nowrap; }
    .table-scroll tr:last-child td { border-bottom: 0; }
    .table-scroll th:last-child, .table-scroll td:last-child { border-right: 0; }

    .doc-foot { margin-top: 36px; color: var(--text-3); font-size: 12.5px; }
  </style>
</head>
<body>
  {{ content | safe }}
  <p class="doc-foot">Last updated {{ updated }}. Also published at wheretotrips.com/legal/.</p>

  <script>
    // Wrap each table so the horizontal scroll lives on a container rather
    // than the page — markdown gives us a bare <table> with nothing to style.
    document.querySelectorAll('table').forEach(function (t) {
      var box = document.createElement('div');
      box.className = 'table-scroll';
      t.parentNode.insertBefore(box, t);
      box.appendChild(t);
    });
    // Tell the app how tall the document is, so it can show its own spinner
    // until there is something real to look at.
    function ping() {
      if (window.ReactNativeWebView) {
        window.ReactNativeWebView.postMessage(JSON.stringify({ ready: true, height: document.body.scrollHeight }));
      }
    }
    window.addEventListener('load', ping);
    document.addEventListener('DOMContentLoaded', ping);
  </script>
</body>
</html>
