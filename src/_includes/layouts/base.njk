{#- ── Font catalog ── -#}
{%- set headingFonts = {
  "dm-serif":     { "stack": "'DM Serif Display', Georgia, serif",   "param": "DM+Serif+Display:ital@0;1" },
  "playfair":     { "stack": "'Playfair Display', Georgia, serif",   "param": "Playfair+Display:ital,wght@0,500;0,700;1,500" },
  "fraunces":     { "stack": "'Fraunces', Georgia, serif",           "param": "Fraunces:ital,wght@0,400;0,600;1,400;1,600" },
  "cormorant":    { "stack": "'Cormorant Garamond', Georgia, serif", "param": "Cormorant+Garamond:ital,wght@0,500;0,700;1,500" },
  "lora":         { "stack": "'Lora', Georgia, serif",               "param": "Lora:ital,wght@0,500;0,600;1,500;1,600" }
} -%}
{%- set bodyFonts = {
  "inter":        { "stack": "'Inter', system-ui, sans-serif",             "param": "Inter:wght@300;400;500;600" },
  "nunito-sans":  { "stack": "'Nunito Sans', system-ui, sans-serif",       "param": "Nunito+Sans:wght@300;400;500;600" },
  "work-sans":    { "stack": "'Work Sans', system-ui, sans-serif",         "param": "Work+Sans:wght@300;400;500;600" },
  "dm-sans":      { "stack": "'DM Sans', system-ui, sans-serif",           "param": "DM+Sans:wght@300;400;500;600" },
  "plus-jakarta": { "stack": "'Plus Jakarta Sans', system-ui, sans-serif", "param": "Plus+Jakarta+Sans:wght@300;400;500;600" },
  "figtree":      { "stack": "'Figtree', system-ui, sans-serif",           "param": "Figtree:wght@300;400;500;600" }
} -%}
{%- set hf = headingFonts[theme.headingFont] or headingFonts["dm-serif"] -%}
{%- set bf = bodyFonts[theme.bodyFont] or bodyFonts["nunito-sans"] -%}
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/meta.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {#- Body font: Noto Sans (matches the app). Heading font RCL Morland is self-hosted (see styles.css @font-face). -#}
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />

  <style>
    :root {
      /* ── App "Azure / Amber / Charcoal" palette ─────────────────── */
      --cream:      #FFFFFF;          /* page base */
      --tint:       #F2F5F7;          /* Soft Azure — alternate section bg */
      --card:       #FFFFFF;
      --navy:       #313131;          /* Charcoal — headings & primary text */
      --navy-light: #4A4A4A;
      --ink-soft:   #5C616A;          /* secondary text */
      --ink-muted:  #8A9098;          /* muted text */
      /* --rust is the historical accent var; repointed to Azure so every accent cascades */
      --rust:        #209CE0;         /* Azure — primary accent / CTA */
      --azure:       #209CE0;
      --azure-press: #1B86C2;
      --azure-tint:  #E6F4FC;
      --amber:       #E69800;         /* secondary accent */
      --amber-tint:  #FBEFD6;
      --footer:      #262626;         /* charcoal-dark footer */
      --footer-low:  #1C1C1C;
      /* cool-gray ramp (repointed from the old warm ramp; names kept for cascade) */
      --wg100: #F7F9FA;
      --wg200: #E2E7EB;
      --wg300: #D2D8DD;
      --wg400: #AEB4BB;
      --wg500: #8A9098;
      --wg600: #5C616A;
      --serif: 'RCL Morland', Georgia, 'Times New Roman', serif;
      --sans:  'Noto Sans', system-ui, -apple-system, sans-serif;
      --max: 1200px;
      --wide: 1425px;
      --radius-lg: 20px;
      --radius-md: 12px;
      --radius-sm: 8px;
      --shadow-sm: 0 2px 12px rgba(20,30,40,0.06);
      --shadow-md: 0 10px 40px rgba(50,50,50,0.10);
      --shadow-lg: 0 20px 60px rgba(20,30,40,0.14);
      --shadow-xl: 0 30px 80px rgba(20,30,40,0.18);
    }
  </style>
  <link rel="stylesheet" href="/assets/styles.css?v={{ buildTime }}" />
  {#- Public Supabase config (anon key — RLS-gated, safe to expose). Consumed by /assets/js/wt-*.js -#}
  <script>window.WT_SUPABASE = { url: "{{ supabase.url }}", anonKey: "{{ supabase.anonKey }}" };</script>
  {#- PostHog — website traffic tagged with a "website" platform property so it
      can be filtered apart from the mobile app in the same PostHog project.
      Skipped entirely on /admin* pages (Netlify CMS + the 3 internal admin
      dashboards) — internal admin activity shouldn't pollute site analytics. -#}
  <script>
    if (!/^\/admin/.test(window.location.pathname)) {
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('{{ site.analytics.posthogKey }}', {
        api_host: '{{ site.analytics.posthogHost }}',
        person_profiles: 'identified_only',
      });
      posthog.register({ platform: 'website' });
    }
  </script>
</head>
<body>
{% include "partials/header.njk" %}

<a id="top"></a>
{{ content | safe }}

{% include "partials/footer.njk" %}
<script type="module" src="/assets/js/wt-track-submit.js?v={{ buildTime }}"></script>

<script>
  var yearEl = document.getElementById('year');
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  // Account links: "Log In" → "My Account" when a Supabase session exists.
  // Lightweight read of the persisted session (no supabase-js needed here).
  (function () {
    try {
      var cfg = window.WT_SUPABASE || {};
      var host = (cfg.url || '').split('//')[1] || '';
      var ref = host.split('.')[0];
      if (!ref) return;
      var raw = localStorage.getItem('sb-' + ref + '-auth-token');
      if (!raw) return;
      var sess = JSON.parse(raw);
      var exp = sess && (sess.expires_at || (sess.currentSession && sess.currentSession.expires_at));
      if (!exp || (exp * 1000) < Date.now()) return; // no valid session
      document.querySelectorAll('[data-wt-account]').forEach(function (a) {
        a.textContent = 'My Account';
        a.setAttribute('href', '/account/profile/');
      });
    } catch (e) { /* treat as logged out */ }
  })();

  // Mobile hamburger menu
  var navToggle = document.querySelector('.nav-toggle');
  var headerEl = document.querySelector('header');
  if (navToggle && headerEl) {
    navToggle.addEventListener('click', function () {
      var open = headerEl.classList.toggle('menu-open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    headerEl.querySelectorAll('.mobile-menu a').forEach(function (a) {
      a.addEventListener('click', function () {
        headerEl.classList.remove('menu-open');
        navToggle.setAttribute('aria-expanded', 'false');
        navToggle.setAttribute('aria-label', 'Open menu');
      });
    });
  }

  // Scroll reveal
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.1, rootMargin: '0px 0px -32px 0px' });
  document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

  // Transparent-over-hero header that solidifies on scroll (home page).
  (function () {
    var heroSlider = document.querySelector('.hero-slider');
    var hdr = document.querySelector('header');
    if (!heroSlider || !hdr) return;
    document.body.classList.add('has-hero-overlay');
    var threshold = 72;
    function onScroll() {
      hdr.classList.toggle('scrolled', window.scrollY > threshold);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();

  // Hero slider (home) — rotating background images, arrows + dots.
  (function () {
    var slider = document.querySelector('[data-hero-slider]');
    if (!slider) return;
    var slides = Array.prototype.slice.call(slider.querySelectorAll('.hero-slide'));
    var dots = Array.prototype.slice.call(slider.querySelectorAll('[data-hero-dot]'));
    if (slides.length < 2) return;
    var i = 0, timer = null;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var DELAY = 6000;

    function go(n) {
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, idx) { s.classList.toggle('active', idx === i); });
      dots.forEach(function (d, idx) { d.classList.toggle('active', idx === i); });
    }
    function next() { go(i + 1); }
    function prev() { go(i - 1); }
    function start() { if (!reduce) { stop(); timer = setInterval(next, DELAY); } }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    var nextBtn = slider.querySelector('[data-hero-next]');
    var prevBtn = slider.querySelector('[data-hero-prev]');
    if (nextBtn) nextBtn.addEventListener('click', function () { next(); start(); });
    if (prevBtn) prevBtn.addEventListener('click', function () { prev(); start(); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { go(parseInt(d.getAttribute('data-hero-dot'), 10)); start(); });
    });
    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
    start();
  })();

  // Vibe chip → image swap (used by feature_split sections with chips)
  document.querySelectorAll('[data-chip-target]').forEach(function (img) {
    var group = img.closest('section');
    if (!group) return;
    var chips = group.querySelectorAll('.chip[data-img]');
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        if (chip.classList.contains('active')) return;
        chips.forEach(function (c) { c.classList.remove('active'); });
        chip.classList.add('active');
        img.classList.add('fading');
        var next = new Image();
        next.src = chip.dataset.img;
        next.onload = function () {
          img.src = chip.dataset.img;
          img.alt = chip.dataset.alt || chip.textContent.trim();
          img.classList.remove('fading');
        };
        setTimeout(function () {
          if (img.classList.contains('fading')) {
            img.src = chip.dataset.img;
            img.classList.remove('fading');
          }
        }, 800);
      });
    });
  });
</script>
</body>
</html>
