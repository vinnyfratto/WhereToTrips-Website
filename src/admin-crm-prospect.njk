---
layout: layouts/base.njk
permalink: /admin-crm-prospect/index.html
title: "Prospect — Partner CRM — WhereTo"
description: "Internal partner CRM prospect record."
eleventyExcludeFromCollections: true
---
<link rel="stylesheet" href="/assets/account.css?v={{ buildTime }}" />
<main id="wt-admin-page">

  <div id="adm-gate" class="gate-msg">Checking access…</div>

  <div id="adm-denied" class="acct" style="display:none;">
    <div class="acct-card" style="text-align:center;">
      <p class="eyebrow">Restricted</p>
      <h1>Access denied</h1>
      <p class="acct-sub">This area is for WhereTo program administrators only.</p>
      <p><a class="btn btn-primary" href="/">Back to home</a></p>
    </div>
  </div>

  <div id="adm-root" class="dash" style="display:none;">
    <div class="dash-head">
      <div>
        <p class="eyebrow"><a href="/admin-crm/">Partner CRM</a> · prospect</p>
        <h1 id="pr-name">…</h1>
        <p class="acct-sub" id="pr-sub"></p>
      </div>
      <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <a href="/admin-crm/" class="btn btn-ghost">Back to pipeline</a>
        <button id="adm-logout" type="button" class="btn btn-ghost">Log out</button>
      </div>
    </div>

    {# Conflict flags and exclusion reasons appear as a BANNER, not a buried
       field (spec §8.2). #}
    <div id="pr-banner"></div>

    <div id="adm-msg" class="alert" role="status" aria-live="polite"></div>

    {# Onboarding checklist is persistent, above the tabs, because item 6 is
       the difference between a partner who can earn and one who cannot. #}
    <section id="pr-onboarding" class="adm-card"></section>

    <div class="adm-tabs" role="tablist">
      <button class="adm-tab is-active" data-tab="overview">Overview</button>
      <button class="adm-tab" data-tab="channels">Channels</button>
      <button class="adm-tab" data-tab="qualification">Qualification</button>
      <button class="adm-tab" data-tab="communications">Communications</button>
      <button class="adm-tab" data-tab="contracts">Contracts</button>
      <button class="adm-tab" data-tab="compliance">Compliance</button>
      <button class="adm-tab" data-tab="content">Content</button>
      <button class="adm-tab" data-tab="assets">Assets</button>
      <button class="adm-tab" data-tab="activity">Activity</button>
    </div>

    <section class="adm-panel" data-panel="overview"></section>
    <section class="adm-panel" data-panel="channels" hidden></section>
    <section class="adm-panel" data-panel="qualification" hidden></section>
    <section class="adm-panel" data-panel="communications" hidden></section>
    <section class="adm-panel" data-panel="contracts" hidden></section>
    <section class="adm-panel" data-panel="compliance" hidden></section>
    <section class="adm-panel" data-panel="content" hidden></section>
    <section class="adm-panel" data-panel="assets" hidden></section>
    <section class="adm-panel" data-panel="activity" hidden></section>
  </div>
</main>
<script type="module" src="/assets/js/wt-admin-crm-prospect.js?v={{ buildTime }}"></script>
