---
layout: layouts/base.njk
permalink: /admin-dashboard/index.html
title: "Admin — WhereTo"
description: "Jump-off point for every WhereTo internal admin tool."
eleventyExcludeFromCollections: true
---
<link rel="stylesheet" href="/assets/account.css?v={{ buildTime }}" />
<main id="wt-admin-page">

  <div id="adm-gate" class="gate-msg">Checking access…</div>

  <div id="adm-denied" class="acct" style="display:none;">
    <div class="acct-card" style="text-align:center;">
      <p class="eyebrow">Restricted</p>
      <h1>Access denied</h1>
      <p class="acct-sub">This area is for WhereTo program administrators only.</p>
      <p><a class="btn btn-primary" href="/">Back to home</a></p>
    </div>
  </div>

  <div id="adm-root" class="dash" style="display:none;">
    <div class="dash-head">
      <div>
        <p class="eyebrow">Internal · admin</p>
        <h1>Admin dashboard</h1>
      </div>
      <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <button id="adm-logout" type="button" class="btn btn-ghost">Log out</button>
      </div>
    </div>

    <div id="adm-msg" class="alert" role="status" aria-live="polite"></div>

    <h2 class="adm-section-h" style="margin-top:0; padding-top:0; border-top:0;">Analytics &amp; growth</h2>
    <div class="adm-tile-grid">
      <a class="adm-tile" href="/analytics/">
        <h3>Site Analytics</h3>
        <p>PostHog traffic, app usage, funnels, devices, location.</p>
      </a>
      <a class="adm-tile" href="/admin-affiliates/">
        <h3>Affiliate Admin</h3>
        <p>Invites, affiliates, commissions, payouts.</p>
      </a>
      <a class="adm-tile" href="/admin-submissions/">
        <h3>Submission Admin</h3>
        <p>Early access and contact form submissions.</p>
      </a>
    </div>

    <h2 class="adm-section-h">Destinations &amp; images</h2>
    <div class="adm-tile-grid">
      <a class="adm-tile" href="/DestImages/">
        <h3>Destination Images</h3>
        <p>Per-destination photo galleries.</p>
      </a>
      <a class="adm-tile" href="/vibesimages/">
        <h3>Vibe Images</h3>
        <p>Per-vibe photo galleries.</p>
      </a>
      <a class="adm-tile" href="/vibes-engine/">
        <h3>Vibes Engine</h3>
        <p>Sub-region blogs and rankings.</p>
      </a>
      <a class="adm-tile" href="/vibes-engine/dashboard.html">
        <h3>Vibe Engine Tester</h3>
        <p>Preview the ranking algorithm.</p>
      </a>
      <a class="adm-tile" href="/DashboardHero/">
        <h3>Dashboard Hero</h3>
        <p>Pick rotating hero destinations.</p>
      </a>
      <a class="adm-tile" href="/StockImages/">
        <h3>Stock Image Ingest</h3>
        <p>AI-curated stock photo pipeline.</p>
      </a>
      <a class="adm-tile" href="/VibeSelection/">
        <h3>Vibe Selection</h3>
        <p>Walk the vibe picker on live engine data.</p>
      </a>
    </div>

    <h2 class="adm-section-h">Content</h2>
    <div class="adm-tile-grid">
      <a class="adm-tile" href="/admin/">
        <h3>WhereTo CMS</h3>
        <p>Sveltia git-based content editor.</p>
      </a>
    </div>
  </div>
</main>
<script type="module" src="/assets/js/wt-admin-home.js?v={{ buildTime }}"></script>
