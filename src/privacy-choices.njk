{#
  The target of the footer's "Do Not Sell or Share My Personal Information"
  link (Privacy Statement Section 8.2). The choice lives in this browser's
  localStorage as wt_ad_optout, which base.njk reads before it loads the Meta
  Pixel. Global Privacy Control is honored without any click. PostHog is our own
  analytics and is not part of "sharing"; it is unaffected.
#}
<section class="block">
  <div class="wrap">
    <div class="rich-text legal-doc" style="max-width: 820px;">
      <h1 style="font-size: clamp(30px, 4vw, 44px); line-height: 1.1; margin: 12px 0 10px;">Your Privacy Choices</h1>
      <p>On wheretotrips.com we use the Meta Pixel to measure our advertising, such as whether an ad led to a visit. That means page views and button clicks on this site are shared with Meta Platforms. Under the California Consumer Privacy Act and similar state laws, that may count as "selling" or "sharing" personal information, and you can opt out.</p>

      <p id="pc-status" role="status" style="font-weight: 600; margin: 24px 0 14px;"></p>
      <p id="pc-gpc" hidden>Your browser is sending a Global Privacy Control signal. We treat that as an opt-out automatically, so there is nothing more to do on this device.</p>
      <p><button type="button" id="pc-toggle" class="btn btn-primary"></button></p>

      <p>This choice is saved in this browser. If you use another browser or device, make the choice there too. Clearing your browser data resets it. To opt out in the WhereTo app, go to Settings, then Privacy, then Privacy Choices. On Android you can also delete your advertising ID in your device settings.</p>
      <p>For everything else, see our <a href="/legal/privacy/">Privacy Statement</a>, or write to <a href="mailto:privacy@wheretotrips.com">privacy@wheretotrips.com</a>.</p>
    </div>
  </div>
</section>
<script>
  (function () {
    var KEY = 'wt_ad_optout';
    var gpc = navigator.globalPrivacyControl === true;
    var status = document.getElementById('pc-status');
    var btn = document.getElementById('pc-toggle');
    function stored() { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } }
    function render() {
      var out = gpc || stored();
      status.textContent = out
        ? 'You are opted out. We are not sharing your activity on this site with Meta.'
        : 'You are not opted out. Your activity on this site is shared with Meta for advertising measurement.';
      document.getElementById('pc-gpc').hidden = !gpc;
      btn.textContent = stored() ? 'Opt back in' : 'Do Not Sell or Share My Personal Information';
      btn.hidden = gpc && !stored();
    }
    btn.addEventListener('click', function () {
      try {
        if (stored()) localStorage.removeItem(KEY); else localStorage.setItem(KEY, '1');
      } catch (e) {
        status.textContent = 'Your browser is blocking storage, so we could not save this choice. Turn on Global Privacy Control in your browser, or email privacy@wheretotrips.com.';
        return;
      }
      render();
      // The Pixel loaded earlier on this page if they were not opted out; a
      // reload is the only way to be sure it is gone.
      if (stored()) location.reload();
    });
    render();
  })();
</script>
