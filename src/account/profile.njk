---
layout: layouts/account.njk
title: "Your WhereTo profile"
description: "Manage your WhereTo account and travel preferences."
eleventyExcludeFromCollections: true
acctWide: true
---
<div id="wt-gate" class="gate-msg">Loading your profile…</div>

{#
  The form's fields are rendered by wt-profile.js, not written here. It covers
  every profile column the app writes, and the same editor is embedded on
  /partner-dashboard/settings/ — two hand-maintained copies of that many
  fields would not have stayed in step.
#}
<div id="wt-profile" class="acct-card" data-wt-page="profile" style="display:none;">
  <div class="acct-toprow">
    <div>
      <p class="eyebrow">Your account</p>
      <h1>Profile</h1>
    </div>
    <div class="acct-toprow-actions">
      <a href="/account/bookings/" class="btn btn-ghost">My bookings</a>
      <a id="wt-aff-dash-link" href="/partner-dashboard/" class="btn btn-primary" style="display:none;">Partner dashboard</a>
      <a id="wt-admin-link" href="/admin-dashboard/" class="btn btn-primary" style="display:none;">Admin dashboard</a>
      <button id="wt-logout" type="button" class="btn btn-ghost">Log out</button>
    </div>
  </div>

  <div id="wt-alert" class="alert" role="status" aria-live="polite"></div>

  <form id="wt-profile-form" novalidate></form>
</div>
