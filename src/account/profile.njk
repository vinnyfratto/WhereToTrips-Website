---
layout: layouts/account.njk
title: "Your WhereTo profile"
description: "Manage your WhereTo account and travel preferences."
eleventyExcludeFromCollections: true
acctWide: true
acctBare: true
---
<div id="wt-gate" class="gate-msg">Loading your profile…</div>

{#
  Everything inside is rendered by wt-profile.js: the photo header, the name,
  the shortcut tiles, the grouped menu, and whichever section is open. It is
  built to the same shape as the app's own profile — a hub you drill into —
  because that is where nearly everyone reads it. The same editor is embedded
  on /partner-dashboard/settings/ with the hub off.
#}
<div id="wt-profile" data-wt-page="profile" style="display:none;">
  <div id="wt-alert" class="alert" role="status" aria-live="polite"></div>
  <div id="wt-profile-body" class="ph is-hub"></div>
</div>

{#
  Solar icon sprite — the profile is rendered in JavaScript, which cannot call
  the {% icon %} shortcode, so the glyphs it needs are rendered here once and
  read out of the DOM. Same set and style the rest of the site and the app use.
#}
<div id="wt-icons" hidden aria-hidden="true">
  <span data-ico="user-circle">{% icon "user-circle" %}</span>
  <span data-ico="users-group-rounded">{% icon "users-group-rounded" %}</span>
  <span data-ico="route">{% icon "route" %}</span>
  <span data-ico="heart">{% icon "heart" %}</span>
  <span data-ico="tuning">{% icon "tuning" %}</span>
  <span data-ico="compass">{% icon "compass" %}</span>
  <span data-ico="bell">{% icon "bell" %}</span>
  <span data-ico="wallet">{% icon "wallet" %}</span>
  <span data-ico="lock-keyhole">{% icon "lock-keyhole" %}</span>
  <span data-ico="shield-check">{% icon "shield-check" %}</span>
  <span data-ico="document-text">{% icon "document-text" %}</span>
  <span data-ico="info-circle">{% icon "info-circle" %}</span>
  <span data-ico="map-point">{% icon "map-point" %}</span>
  <span data-ico="camera">{% icon "camera" %}</span>
  <span data-ico="logout-2">{% icon "logout-2" %}</span>
  <span data-ico="alt-arrow-right">{% icon "alt-arrow-right" %}</span>
  <span data-ico="alt-arrow-left">{% icon "alt-arrow-left" %}</span>
</div>
