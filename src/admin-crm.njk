---
layout: layouts/base.njk
permalink: /admin-crm/index.html
title: "Partner CRM — WhereTo"
description: "Internal partner curation, onboarding, and content-approval CRM."
eleventyExcludeFromCollections: true
---
<link rel="stylesheet" href="/assets/account.css?v={{ buildTime }}" />
<main id="wt-admin-page">

  <div id="adm-gate" class="gate-msg">Checking access…</div>

  <div id="adm-denied" class="acct" style="display:none;">
    <div class="acct-card" style="text-align:center;">
      <p class="eyebrow">Restricted</p>
      <h1>Access denied</h1>
      <p class="acct-sub">This area is for WhereTo program administrators only.</p>
      <p><a class="btn btn-primary" href="/">Back to home</a></p>
    </div>
  </div>

  <div id="adm-root" class="dash" style="display:none;">
    <div class="dash-head">
      <div>
        <p class="eyebrow">Internal · admin</p>
        <h1>Partner CRM</h1>
      </div>
      <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <a href="/admin-dashboard/" class="btn btn-ghost">Admin Home</a>
        <a href="/admin-affiliates/" class="btn btn-ghost">Affiliate Admin</a>
        <button id="adm-logout" type="button" class="btn btn-ghost">Log out</button>
      </div>
    </div>

    <div class="adm-tabs" role="tablist">
      <button class="adm-tab is-active" data-tab="overview">Overview</button>
      <button class="adm-tab" data-tab="pipeline">Pipeline</button>
      <button class="adm-tab" data-tab="queue">Review Queue</button>
      <button class="adm-tab" data-tab="import">Import</button>
      <button class="adm-tab" data-tab="activity">Activity</button>
    </div>

    <div id="adm-msg" class="alert" role="status" aria-live="polite"></div>

    <section class="adm-panel" data-panel="overview"></section>
    <section class="adm-panel" data-panel="pipeline" hidden></section>
    <section class="adm-panel" data-panel="queue" hidden></section>
    <section class="adm-panel" data-panel="import" hidden></section>
    <section class="adm-panel" data-panel="activity" hidden></section>
  </div>
</main>
<script type="module" src="/assets/js/wt-admin-crm.js?v={{ buildTime }}"></script>
