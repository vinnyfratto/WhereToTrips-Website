---
layout: layouts/admin.njk
permalink: /admin-payment-history/index.html
title: "Payment History — WhereTo"
description: "Every payment made to a partner."
eleventyExcludeFromCollections: true
subnav: partner
subnavActive: payments
---
<main id="wt-admin-page">

  {% include "partials/admin-gate.njk" %}

  <div id="adm-root" class="dash pa-wide" style="display:none;">
    <div class="dash-head">
      <div>
        <p class="eyebrow">Partner Admin</p>
        <h1>Payment History</h1>
        <p class="pa-lede">Every payment made to a partner.</p>
      </div>
    </div>

    <div id="adm-msg" class="alert" role="status" aria-live="polite"></div>

    <div class="pa-controls">
      <div class="field">
        <label for="ph-q">Search by name</label>
        <input id="ph-q" type="search" placeholder="Partner name, ID or code" autocomplete="off" />
      </div>
      <div class="field">
        <label for="ph-from">From</label>
        <input id="ph-from" type="date" />
      </div>
      <div class="field">
        <label for="ph-to">To</label>
        <input id="ph-to" type="date" />
      </div>
      <span class="pa-spacer"></span>
      <span class="pa-count" id="ph-count" aria-live="polite"></span>
    </div>

    <div id="ph-table"></div>
  </div>
</main>
<script type="module" src="/assets/js/wt-admin-payment-history.js?v={{ buildTime }}"></script>
